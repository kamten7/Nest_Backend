<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nest</groupId>
        <artifactId>nest-rent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>nest-order</artifactId>
    <packaging>jar</packaging>
    <name>Nest Order</name>
    <description>租房订单模块：确认租房、缴押金、缴租/提前支付、退租结算、押金锁定与到期提醒</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.nest</groupId>
            <artifactId>nest-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nest</groupId>
            <artifactId>nest-pojo</artifactId>
        </dependency>
        <!-- 资金流转依赖钱包模块的 transferPay（单向：order -> wallet） -->
        <dependency>
            <groupId>com.nest</groupId>
            <artifactId>nest-wallet</artifactId>
        </dependency>
        <!-- 到期提醒依赖推送通道（PushService） -->
        <dependency>
            <groupId>com.nest</groupId>
            <artifactId>nest-chat</artifactId>
        </dependency>

        <!-- Web 层（Controller / 参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 持久层 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
        </dependency>

        <!-- API 文档注解 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：JUnit5 + Mockito + AssertJ（纯单元测试，无需启动 Spring） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
