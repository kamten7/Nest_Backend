<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nest.mapper.TenantMapper">

    <select id="selectByOpenid" resultType="Tenant">
        SELECT * FROM tenant WHERE openid = #{openid}
    </select>

    <select id="selectByPhone" resultType="Tenant">
        SELECT * FROM tenant WHERE phone = #{phone}
    </select>

    <select id="selectById" resultType="Tenant">
        SELECT * FROM tenant WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tenant (openid, nickname, avatar, phone, gender, status, create_time, update_time)
        VALUES (#{openid}, #{nickname}, #{avatar}, #{phone}, #{gender}, 1, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE tenant
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="gender != null">gender = #{gender},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
