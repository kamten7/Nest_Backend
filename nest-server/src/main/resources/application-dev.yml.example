# ============================================================
# Nest 租房平台开发环境配置模板
# 复制此文件为 application-dev.yml 并填入真实值
# ============================================================

nest:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3309
    database: nest_rent
    username: root
    password: your_mysql_password

  # 微信小程序登录
  # ⚠️ mock-enabled=true 时不会调用微信，openid 由 mock-openid 固定提供（本地反复登录=同一租客）
  # ⚠️ 走真实登录必须：mock-enabled=false，且 appid/secret 与小程序 AppID 完全一致，否则 jscode2session 报 40013
  wechat:
    appid: ${NEST_WECHAT_APPID:}
    secret: ${NEST_WECHAT_SECRET:}
    mock-enabled: ${NEST_WECHAT_MOCK:true}
    mock-openid: ${NEST_WECHAT_MOCK_OPENID:nest_dev_tenant}

# MinIO 对象存储（开发环境使用 Docker Compose 中的 MinIO）
# NEST_MINIO_ENDPOINT=http://localhost:9012
# NEST_MINIO_ACCESS_KEY=minioadmin
# NEST_MINIO_SECRET_KEY=minioadmin
# NEST_MINIO_BUCKET=nest-rent
# NEST_MINIO_AVATAR_BUCKET=nest-avatar   # 用户头像专用 bucket（不存在会自动创建）

# AI 配置（管理端/房东端）
# NEST_AI_ADMIN_BASE_URL=https://api.siliconflow.cn/v1
# NEST_AI_ADMIN_API_KEY=your_siliconflow_key
# NEST_AI_ADMIN_MODEL=deepseek-ai/DeepSeek-V3

# AI 配置（用户端/租客端）—— 智谱 GLM-4-Flash 免费
# NEST_AI_USER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# NEST_AI_USER_API_KEY=your_zhipu_key
# NEST_AI_USER_MODEL=glm-4-flash
