# ============================================================================
# Nest 一键启动环境变量模板
# 用法：cp .env.example .env，按注释填值，然后 docker compose --profile full up -d --build
# 注意：.env 已被 .gitignore 忽略，不要提交真实口令/API Key
# ============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DATABASE=nest_rent
NEST_MYSQL_PORT=3309

# ---------- Redis ----------
REDIS_PASSWORD=change-me-please
NEST_REDIS_PORT=6381

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
# MinIO 要求 root 密码至少 8 位，否则容器会直接 exited (1)
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=nest-rent
MINIO_AVATAR_BUCKET=nest-avatar
NEST_MINIO_PORT=9012
NEST_MINIO_CONSOLE_PORT=9013
# 浏览器访问 MinIO 的地址（容器内后端用 http://minio:9000，但返回给前端的 URL 用这个）
NEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9012

# ---------- JWT（两把必须不同，建议各 32 位以上随机串） ----------
NEST_JWT_ADMIN_SECRET=replace-with-a-random-32-plus-char-secret
NEST_JWT_USER_SECRET=replace-with-another-random-32-plus-char-secret

# ---------- pgvector（RAG 知识库） ----------
NEST_PGVECTOR_DB=nest_rag
NEST_PGVECTOR_USER=nest
NEST_PGVECTOR_PASSWORD=change-me-please
NEST_PGVECTOR_PORT=5433
NEST_RAG_ENABLED=true
NEST_RAG_INGEST_ON_STARTUP=true

# ---------- 服务端口 ----------
NEST_HTTP_PORT=8080
NEST_WS_PORT=8081
NEST_MANAGEMENT_PORT=9090
NEST_FRONTEND_PORT=80

# ---------- 可观测性（--profile obs） ----------
NEST_PROMETHEUS_PORT=9091
NEST_GRAFANA_PORT=3000
NEST_GRAFANA_PASSWORD=admin

# ---------- AI（不填则 AI 找房不可用，其余功能不受影响） ----------
NEST_AI_USER_BASE_URL=https://api.siliconflow.cn/v1
NEST_AI_USER_API_KEY=
NEST_AI_USER_MODEL=deepseek-ai/DeepSeek-V3
NEST_AI_ADMIN_BASE_URL=https://api.siliconflow.cn/v1
NEST_AI_ADMIN_API_KEY=
NEST_AI_ADMIN_MODEL=deepseek-ai/DeepSeek-V3

# ---------- 微信小程序（demo 模式默认走 mock 登录） ----------
NEST_WECHAT_APPID=
NEST_WECHAT_SECRET=
NEST_WECHAT_MOCK=true
NEST_WECHAT_MOCK_OPENID=nest_demo_tenant

# ---------- CORS（prod 必须填具体来源，禁止 *） ----------
NEST_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
